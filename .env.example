CONTROL_PLANE_TUNNEL_ID=<existing-tunnel-id>

# Docker socket group ID on the host.
# Set this to the numeric GID of /var/run/docker.sock.
DOCKER_GID=<docker-socket-gid>

OPEN_SHELL_WORKSPACE=default
SANDBOX_IMAGE=local-mcp-openshell-sandbox:1.0.0
SANDBOX_DEFAULT_CPU=1
SANDBOX_DEFAULT_MEMORY=1GiB

OPENSHELL_PORT=8080
OPENSHELL_HEALTH_PORT=8081
