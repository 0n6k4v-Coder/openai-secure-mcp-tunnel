# For development CLI commands, use separate XDG roots and select this Compose file.
# export XDG_CONFIG_HOME="$HOME/.config/openai-secure-mcp-tunnel-development"
# export XDG_STATE_HOME="$HOME/.local/state/openai-secure-mcp-tunnel-development"
# export COMPOSE_ENV_FILES="$PWD/deploy/.env.development"
# export OPENSHELL_CLI_GATEWAY=https://127.0.0.1:18080

COMPOSE_PROJECT_NAME=openai-secure-mcp-tunnel-development

OPENSHELL_WORKSPACE=development
OPENSHELL_IMAGE_TAG=latest
OPENSHELL_PORT=18080
OPENSHELL_HEALTH_PORT=18081
OPENSHELL_GATEWAY=local
OPENSHELL_CLI_GATEWAY=https://127.0.0.1:18080
OPENSHELL_CONTAINER_GATEWAY=https://openshell-gateway:8080

MCP_PORT=18000
MCP_CONFIG_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/local-mcp-server/config/development
MCP_STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/local-mcp-server/mcp/development
WORKSPACE_GRANTS_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/local-mcp-server/mcp/development/workspace-grants

SANDBOX_IMAGE=local-mcp-openshell-sandbox:1.0.0
BROWSER_SANDBOX_IMAGE=local-mcp-browser-sandbox:1.0.0
WORKSPACE_ACL_HELPER_IMAGE=local-mcp-workspace-acl-helper:1.0.0
SANDBOX_DEFAULT_CPU=1
SANDBOX_DEFAULT_MEMORY=1Gi
BROWSER_ALLOWED_ENDPOINTS=host.openshell.internal:4173,mtioon.com:443,www.mtioon.com:443

INSTALLATION_TIMEOUT_SECONDS=300
LOG_LEVEL=DEBUG