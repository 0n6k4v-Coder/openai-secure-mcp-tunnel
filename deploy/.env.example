# Run with:
# docker compose --env-file deploy/.env -f deploy/compose.yaml up -d
#
# Runtime state is stored under XDG_STATE_HOME and never under the repository.

COMPOSE_PROJECT_NAME=openai-secure-mcp-tunnel-production

OPENSHELL_WORKSPACE=default
OPENSHELL_IMAGE_TAG=latest
OPENSHELL_PORT=8080
OPENSHELL_HEALTH_PORT=8081
OPENSHELL_GATEWAY=local
OPENSHELL_CLI_GATEWAY=https://127.0.0.1:8080

MCP_PORT=8000
MCP_CONFIG_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/local-mcp-server/config
MCP_STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/local-mcp-server/mcp
WORKSPACE_GRANTS_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/local-mcp-server/mcp/workspace-grants

SANDBOX_IMAGE=local-mcp-openshell-sandbox:1.0.0
BROWSER_SANDBOX_IMAGE=local-mcp-browser-sandbox:1.0.0
WORKSPACE_ACL_HELPER_IMAGE=local-mcp-workspace-acl-helper:1.0.0
SANDBOX_DEFAULT_CPU=1
SANDBOX_DEFAULT_MEMORY=1Gi
BROWSER_ALLOWED_ENDPOINTS=host.openshell.internal:4173,mtioon.com:443,www.mtioon.com:443

INSTALLATION_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO